{
  "name": "graduation-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/idea-service.test.js dist-tests/tests/decision-service.test.js dist-tests/tests/task-service.test.js dist-tests/tests/milestone-service.test.js dist-tests/tests/standup-service.test.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedadel96e/Graduation-Bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mohamedadel96e/Graduation-Bot/issues"
  },
  "homepage": "https://github.com/mohamedadel96e/Graduation-Bot#readme",
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "node-cron": "^4.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
